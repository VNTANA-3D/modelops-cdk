STACK_NAME="ModelopsHandler"
AWS_ACCOUNT_ID="12345"
AWS_REGION="us-east-1"

# Compute Backend: "batch" (AWS Batch/Fargate), "eks" (EKS/Kubernetes), or "deadline" (Deadline Cloud)
COMPUTE_BACKEND=batch

# VPC Configuration (shared by both backends)
USE_DEFAULT_VPC=true
USE_SPOT_INSTANCES=false
VPC_ID=
SUBNET_IDS=

# S3 and Job Configuration
S3_BUCKET_NAME=
JOB_MEMORY=30
JOB_CPU=4
JOB_EPHEMERAL_STORAGE_SIZE=30
JOB_RETRY_ATTEMPTS=3
JOB_POLICY_FILE=

# Logging
LOG_GROUP_NAME=
LOG_GROUP_STREAM_PREFIX=ecs

# EKS-specific Configuration (only used when COMPUTE_BACKEND=eks)
# EKS_CLUSTER_NAME=modelops-cluster
# EKS_NAMESPACE=modelops
# EKS_NODE_INSTANCE_TYPE=c5.4xlarge
# EKS_CREATE_VPC=true
# EKS_VPC_CIDR=10.0.0.0/16
# EKS_KUBECONFIG_PATH=

# Deadline Cloud-specific Configuration (only used when COMPUTE_BACKEND=deadline)
# DEADLINE_FARM_ID=
# DEADLINE_FARM_NAME=
# DEADLINE_QUEUE_ID=
# DEADLINE_FLEET_ID=
# DEADLINE_FLEET_MIN=0
# DEADLINE_FLEET_MAX=10
